# LLM Configuration
# Option A: Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here

# Option B: OpenAI / OpenRouter / Custom compatible API
# Example for OpenRouter models like openai/gpt-oss-120b:
# OPENAI_API_KEY=sk-or-v1-your_openrouter_api_key
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=openai/gpt-oss-120b
#
# Example for direct OpenAI:
# OPENAI_API_KEY=sk-proj-your_openai_api_key
# LLM_MODEL=gpt-4o-mini

# Application Configuration
APP_HOST=127.0.0.1
APP_PORT=8000
DATA_DIR=data
UPLOADS_DIR=uploads/resumes
DB_PATH=data/assistant.db

# SMTP Configuration (Used in Phase 4 for sending emails)
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your_email@gmail.com
# SMTP_PASSWORD=your_app_password
# DRY_RUN=True  # In Dry Run mode, emails are drafted and logged without actually sending

